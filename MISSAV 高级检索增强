// ==UserScript==
// @name         MISSAV 高级检索增强 (3.5 搜索修复版)
// @namespace    https://github.com
// @description  修复搜索按钮 + Tab 内容显示
// @author       Grok
// @match        https://missav.ws/*
// @match        https://*.missav.ws/*
// @match        *://missav.*/*
// @grant        GM_addStyle
// @run-at       document-start
// ==/UserScript==

(function () {
    'use strict';

    GM_addStyle(`
        #missav-float-btn {position:fixed;bottom:25px;right:25px;width:68px;height:68px;background:linear-gradient(135deg,#8b5cf6,#ec4899);color:white;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:34px;box-shadow:0 10px 35px rgba(139,92,246,0.6);cursor:pointer;z-index:2147483647;}
        #missav-panel {position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);width:980px;height:88vh;background:rgba(15,15,25,0.97);backdrop-filter:blur(20px);border-radius:22px;border:1px solid rgba(139,92,246,0.3);box-shadow:0 25px 70px rgba(0,0,0,0.9);z-index:2147483647;overflow:hidden;display:none;flex-direction:column;color:#e0d9ff;}
        .tab-bar {display:flex;background:rgba(0,0,0,0.5);padding:10px;gap:8px;flex-wrap:wrap;}
        .tab {padding:12px 22px;border-radius:14px;cursor:pointer;transition:0.3s;}
        .tab.active {background:#8b5cf6;color:white;}
        .tag {padding:9px 17px;background:rgba(255,255,255,0.1);border-radius:999px;cursor:pointer;margin:5px;transition:0.2s;}
        .tag:hover {background:rgba(236,72,153,0.4);}
        .tag.active {background:#ec4899;color:white;}
        .content-area {flex:1;overflow-y:auto;padding:25px;}
        input, select {background:#1f1f2e !important;border:1px solid rgba(139,92,246,0.5) !important;color:#e0d9ff !important;padding:12px;border-radius:10px;}
        .selected-tag {background:rgba(236,72,153,0.35);padding:6px 14px;border-radius:999px;margin:4px;display:inline-flex;align-items:center;gap:8px;}
        .remove-btn {cursor:pointer;color:#ff80ab;font-weight:bold;}
    `);

    let selectedTags = [];
    let currentTab = 'search';

    const CATEGORIES = {
        "👗 衣着": [ "黑絲","過膝襪","運動裝","肉絲","絲襪","眼鏡娘","獸耳","漁網","水着","校服","旗袍","婚紗","女僕","和服","吊帶襪","兔女郎","Cosplay","制服","裸足","高跟鞋","內衣","泳裝","迷你裙","長靴","白色連衣裙"],
        "💃 身材": ["黑肉","長身","軟體","貧乳","美腿","美尻","紋身","短髮","白虎","熟女","巨乳","少女","嬌小","豐滿","纖細","小麥色","美白","長髮","大膽","美乳"],
        "🔥 交合": [ "顏射","腳交","肛交","痙攣","潮吹","深喉","接吻","口爆","口交","乳交","中出","手淫","素人","舔陰","指姦","舔肛","69","後背位","正常位","騎乘位"],
        "🎮 玩法": ["SM","調教","露出","NTR","露出","集團進犯","進犯","調教","綑綁","瞬間插入","痴漢","痴女","男M","泥醉","泡姬","母乳","放尿","按摩","多P","刑具","凌辱","一日十回","3P","4P","輪姦","拘束","電擊","浣腸","羞恥"],
        "📖 剧情": ["人妻","女學生","女教師","出軌","黑人","醜男","誘惑","親屬","童貞","時間停止","復仇","年齡差","巨漢","媚藥","夫目前犯","出軌","催眠","偷拍","下雨天","NTR","寢取","寢返","純愛","ntr","逆NTR","強姦","和姦","監禁","逃亡"],
        "🎭 角色": ["風俗娘","醫生","逃犯","護士","老師","空姐","球隊經理","未亡人","搜查官","情侶","家政婦","家庭教師","偶像","人妻","主播","OL","女社長","女學生","巫女","女警","秘書","鄰居","義母","女教师","大小姐"],
        "📍  地點": ["魔鏡號","電車","處女","監獄","溫泉","洗浴場","泳池","汽車","廁所","學校","圖書館","健身房","便利店","旅館","露天","辦公室","教室","病院","海邊","電梯"],
        "📦 雜項": ["錄像","処女作","引退作","綜藝","節日主題","感謝祭","4小時以上","高清","中文字幕","無碼","有碼","單體作品","合集","配信限定","藍光","VR","素人","FC2","個人撮影","主觀視角"]
    };

    const STUDIOS = ["SOD","S1","Moodyz","Prestige","Idea Pocket","Madonna","MIDE","SSNI"];
    const HOT_CATEGORIES = ["本日熱門","本週熱門","本月熱門","最新更新","新作上市","無碼流出","素人作品","VR专区"];
    const POPULAR_ACTRESS = ["三上悠亚","Julia","桥本有菜","相沢南","深田えいみ","桃乃木かな","石原希望","弥生みづき"];

    function buildSearchUrl() {
        const keywordInput = document.getElementById('main-keyword');
        const keyword = keywordInput ? keywordInput.value.trim() : '';
        const parts = keyword ? [encodeURIComponent(keyword)] : [];
        selectedTags.forEach(t => parts.push(encodeURIComponent(t)));
        const base = `https://${location.hostname}`;
        return parts.length ? `${base}/cn/search/${parts.join('+')}` : `${base}/cn`;
    }

    function createUI() {
        if (document.getElementById('missav-panel')) return;

        const btn = document.createElement('div');
        btn.id = 'missav-float-btn';
        btn.innerHTML = '🔍';
        document.body.appendChild(btn);

        const panel = document.createElement('div');
        panel.id = 'missav-panel';
        panel.innerHTML = `
            <div style="padding:18px 24px;background:rgba(0,0,0,0.6);display:flex;justify-content:space-between;" id="header">
                <h2 style="margin:0;color:#c4b5fd;">MISSAV 高级检索</h2>
                <span id="close-panel" style="font-size:30px;cursor:pointer;">✕</span>
            </div>
            <div class="tab-bar" id="tab-bar"></div>
            <div class="content-area" id="content-area"></div>
            <div style="padding:14px 24px;background:rgba(0,0,0,0.7);display:flex;justify-content:space-between;align-items:center;">
                <div id="selected-tags" style="flex:1;display:flex;flex-wrap:wrap;gap:6px;"></div>
                <div>
                    <button id="clear-all" style="margin-right:10px;padding:10px 20px;background:#444;border:none;border-radius:10px;color:white;">🗑 清空</button>
                    <button id="search-final" style="background:#ec4899;padding:12px 32px;border:none;border-radius:14px;color:white;font-weight:bold;">🚀 搜索</button>
                </div>
            </div>
        `;
        document.body.appendChild(panel);

        const tabs = [
            {id:'search', name:'🔍 搜索'},
            {id:'category', name:'🏷️ 分类'},
            {id:'theme', name:'📂 主题'},
            {id:'actress', name:'👩 女优'},
            {id:'studio', name:'🏭 厂商'},
            {id:'hot', name:'🔥 热门'}
        ];

        const tabBar = panel.querySelector('#tab-bar');
        tabs.forEach(tab => {
            const el = document.createElement('div');
            el.className = `tab ${tab.id === currentTab ? 'active' : ''}`;
            el.textContent = tab.name;
            el.dataset.tab = tab.id;
            el.onclick = () => switchTab(tab.id);
            tabBar.appendChild(el);
        });

        btn.onclick = () => { panel.style.display = 'flex'; setTimeout(() => switchTab(currentTab), 100); };
        panel.querySelector('#close-panel').onclick = () => panel.style.display = 'none';

        // 重要：直接绑定搜索按钮
        panel.querySelector('#search-final').onclick = function() {
            const url = buildSearchUrl();
            window.open(url, '_blank');
        };

        panel.querySelector('#clear-all').onclick = () => {
            selectedTags = [];
            updateSelectedTags();
        };
    }

    function switchTab(tab) {
        currentTab = tab;
        const area = document.getElementById('content-area');
        if (!area) return;

        document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t.dataset.tab === tab));

        let html = '';

        if (tab === 'search') {
            html = `<input type="text" id="main-keyword" placeholder="输入关键词、女优名、番号..." style="width:100%;padding:16px;font-size:17px;">`;
        } else if (tab === 'category') {
            html = Object.entries(CATEGORIES).map(([title, tags]) => `
                <div style="margin:22px 0 12px;color:#c4b5fd;font-size:18px;">${title}</div>
                <div style="display:flex;flex-wrap:wrap;gap:8px;">${tags.map(tag => `<div class="tag" data-tag="${tag}">${tag}</div>`).join('')}</div>
            `).join('');
        } else if (tab === 'theme') {
            const items = ["中文字幕","VR","制服誘惑","絲襪美腿","巨乳","素人","NTR","人妻","角色劇情", "直接開啪","多P群交","主奴調教","男友視角","凌辱快感","盜攝偷拍","無碼解放","女同歡愉","素人作品", ];
            html = `<div style="display:flex;flex-wrap:wrap;gap:10px;">${items.map(i => `<div class="tag" data-tag="${i}">${i}</div>`).join('')}</div>`;
        } else if (tab === 'actress') {
            html = `
                <input type="text" id="actress-name" placeholder="女优名字（如：三上悠亚）" style="width:100%;margin-bottom:15px;">
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;">
                    <select id="height"><option value="">身高</option><option>150-160cm</option><option>160-170cm</option><option>170cm+</option></select>
                    <select id="cup"><option value="">罩杯</option><option>A杯</option><option>B杯</option><option>C杯</option><option>D杯</option><option>E杯</option></select>
                    <select id="age"><option value="">年龄</option><option>18-25岁</option><option>26-30岁</option><option>31-35岁</option></select>
                </div>
                <button id="add-actress-btn" style="margin:20px 0;padding:12px 26px;background:#8b5cf6;border:none;border-radius:10px;width:100%;">加入筛选条件</button>
                <div style="margin-top:10px;"><strong>热门女优：</strong></div>
                <div style="display:flex;flex-wrap:wrap;gap:8px;">${POPULAR_ACTRESS.map(a => `<div class="tag" data-tag="${a}">${a}</div>`).join('')}</div>
            `;
        } else if (tab === 'studio') {
            html = `<div style="display:flex;flex-wrap:wrap;gap:10px;">${STUDIOS.map(s => `<div class="tag" data-tag="${s}">${s}</div>`).join('')}</div>`;
        } else if (tab === 'hot') {
            html = `<div style="display:flex;flex-wrap:wrap;gap:10px;">${HOT_CATEGORIES.map(h => `<div class="tag" data-tag="${h}">${h}</div>`).join('')}</div>`;
        }

        area.innerHTML = html;

        setTimeout(() => {
            document.querySelectorAll('.tag').forEach(el => {
                el.onclick = () => {
                    const tag = el.dataset.tag;
                    if (tag && !selectedTags.includes(tag)) {
                        selectedTags.push(tag);
                        updateSelectedTags();
                    }
                };
            });

            const addBtn = document.getElementById('add-actress-btn');
            if (addBtn) addBtn.onclick = addActressFilter;
        }, 100);
    }

    function addActressFilter() {
        const name = document.getElementById('actress-name')?.value.trim();
        if (name && !selectedTags.includes(name)) {
            selectedTags.push(name);
            updateSelectedTags();
        }
    }

    function updateSelectedTags() {
        const container = document.getElementById('selected-tags');
        if (container) {
            container.innerHTML = selectedTags.map(tag => `
                <span class="selected-tag">${tag} <span class="remove-btn" onclick="event.stopImmediatePropagation(); removeTag('${tag}')">✕</span></span>
            `).join('');
        }
    }

    window.removeTag = function(tag) {
        selectedTags = selectedTags.filter(t => t !== tag);
        updateSelectedTags();
    };

    function init() {
        if (document.body) createUI();
        else setTimeout(init, 400);
    }

    init();
    window.addEventListener('load', init);
})();
