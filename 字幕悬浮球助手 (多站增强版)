  /** Displays a toast message. */
  function showToast(message, duration = 3000) {
    // 清理旧的Toast
    if (State.runtime.currentToast) {
      clearTimeout(State.runtime.currentToast.timeout);
      if (State.runtime.currentToast.element.parentNode) {
        State.runtime.currentToast.element.parentNode.removeChild(State.runtime.currentToast.element);
      }
    }

    const toast = document.createElement("div");
    toast.textContent = message;
    toast.style.cssText = `
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: rgba(0, 0, 0, 0.75);
            color: white;
            padding: 10px 20px;
            border-radius: 6px;
            z-index: 10002;
            font-size: 14px;
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
            max-width: 300px;
            text-align: center;
        `;
    document.body.appendChild(toast);

    // 保存当前Toast引用
    State.runtime.currentToast = {
      element: toast
    };

    setTimeout(() => { toast.style.opacity = "1"; }, 50);
    State.runtime.currentToast.timeout = setTimeout(() => {
      toast.style.opacity = "0";
      setTimeout(() => {
        if (toast.parentNode) {
          toast.parentNode.removeChild(toast);
          State.runtime.currentToast = null;
        }
      }, 300);
    }, duration);
  }

  /** Displays a toast message with search URL that can be copied. */
  function showSearchUrlToast(sourceName, searchUrl) {
    // 清理旧的Toast
    if (State.runtime.currentToast) {
      clearTimeout(State.runtime.currentToast.timeout);
      if (State.runtime.currentToast.element.parentNode) {
        State.runtime.currentToast.element.parentNode.removeChild(State.runtime.currentToast.element);
      }
    }

    const toast = document.createElement("div");
    toast.style.cssText = `
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: rgba(0, 0, 0, 0.9);
            color: white;
            padding: 12px 16px;
            border-radius: 6px;
            z-index: 10002;
            font-size: 13px;
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
            max-width: 400px;
            text-align: left;
            line-height: 1.4;
        `;

    const message = document.createElement("div");
    message.textContent = `无法自动打开 ${sourceName} 搜索，请手动复制以下链接到浏览器：`;
    message.style.marginBottom = "8px";

    const urlContainer = document.createElement("div");
    urlContainer.style.cssText = `
            background: rgba(255, 255, 255, 0.1);
            padding: 8px 10px;
            border-radius: 4px;
            margin-bottom: 8px;
            word-break: break-all;
            font-family: monospace;
            font-size: 12px;
        `;

    const urlText = document.createElement("span");
    urlText.textContent = searchUrl;

    const copyButton = document.createElement("button");
    copyButton.textContent = "复制链接";
    copyButton.style.cssText = `
            background: #4a90e2;
            color: white;
            border: none;
            padding: 4px 8px;
            border-radius: 3px;
            font-size: 11px;
            cursor: pointer;
            margin-top: 8px;
        `;

    copyButton.addEventListener("click", () => {
      navigator.clipboard.writeText(searchUrl).then(() => {
        copyButton.textContent = "已复制";
        setTimeout(() => {
          copyButton.textContent = "复制链接";
        }, 2000);
      }).catch(err => {
        console.error("无法复制链接:", err);
        showToast("复制链接失败");
      });
    });

    urlContainer.appendChild(urlText);
    toast.appendChild(message);
    toast.appendChild(urlContainer);
    toast.appendChild(copyButton);

    document.body.appendChild(toast);

    // 保存当前Toast引用
    State.runtime.currentToast = {
      element: toast
    };

    setTimeout(() => { toast.style.opacity = "1"; }, 50);
    State.runtime.currentToast.timeout = setTimeout(() => {
      toast.style.opacity = "0";
      setTimeout(() => {
        if (toast.parentNode) {
          toast.parentNode.removeChild(toast);
          State.runtime.currentToast = null;
        }
      }, 300);
    }, 10000); // 显示10秒，给用户足够的时间复制链接
  }

  // --- Initialization ---
  async function initializeScript() {
    console.log(
      "Missav Script: Initializing Safari compatibility build with font size support...",
    );

    // Load settings first
    await loadSettings();

    setupSubtitleDisplay();
    createControlPanel();
    createShowControlsButton();
    hideControlPanel();
    window.addEventListener("resize", throttledHandleViewportChange);
    setupPlayerBridge();
    setupShortcuts();
    initPlayer();
    console.log(
      "Missav Script: Initialization complete. 字体大小修改功能已启用（控制面板 → 字幕字体大小）",
    );

    // 动态监听播放器变化（彻底解决元素丢失）
    subtitleObserver = new MutationObserver(() => {
      if (findVideoContainer() !== lastVideoContainer) {
        ensureSubtitleElementAttached();
      }
    });
    subtitleObserver.observe(document.body, { childList: true, subtree: true });

    console.log("🚀 字幕助手已开启【中途加载 + 显示失效】双修复模式");

    // 清理函数
    function cleanup() {
      if (State.runtime.playerMonitorInterval) {
        clearInterval(State.runtime.playerMonitorInterval);
        State.runtime.playerMonitorInterval = null;
      }
      if (subtitleObserver) {
        subtitleObserver.disconnect();
        subtitleObserver = null;
      }
    }

    // 页面卸载时清理
    window.addEventListener("beforeunload", cleanup);
  }

  let initStarted = false;
  const observer = new MutationObserver((mutationsList, obs) => {
    const playerElement = findVideoElement();
    if (playerElement && !initStarted) {
      console.log(
        "Missav Script: Player element detected, running main script.",
      );
      initStarted = true;
      obs.disconnect();
      initializeScript().catch((error) => {
        console.error("Missav Script: Initialization error:", error);
      });
    }
  });

  observer.observe(document.documentElement || document.body, {
    childList: true,
    subtree: true,
  });

  setTimeout(() => {
    if (!initStarted) {
      console.log(
        "Missav Script: Fallback timer triggered, attempting initialization.",
      );
      initStarted = true;
      observer.disconnect();
      initializeScript().catch((error) => {
        console.error("Missav Script: Initialization error:", error);
      });
    }
  }, 4000);
})(); // End of IIFE
