  /** Searches subtitles using the selected source. */
  async function searchSubtitleBySource(source) {
    let videoID = getSmartVideoCode();
    if (!videoID || videoID.length < 3) {
      videoID = getCurrentVideoID();
    }
    if (!videoID) {
      showToast("无法获取当前视频番号");
      return;
    }

    closeSubtitleList();
    showToast(`正在使用 ${source.name} 搜索字幕: ${videoID}...`);

    try {
      if (source.type === "external") {
        // 外部网站搜索，直接打开新标签
        const searchUrl = source.url.replace(
          "{query}",
          encodeURIComponent(videoID),
        );
        console.log(`Opening search URL: ${searchUrl}`);

        // 直接使用window.open，绕过GM.openInTab的可能限制
        const newWindow = window.open(searchUrl, "_blank", "noopener,noreferrer");
        console.log(`window.open result:`, newWindow);

        if (newWindow) {
          // 尝试聚焦新窗口
          try {
            newWindow.focus();
            console.log("Successfully focused new window");
          } catch (focusError) {
            console.warn("Could not focus new window:", focusError);
          }
          showToast(`正在打开 ${source.name} 搜索: ${videoID}`);
        } else {
          console.error("window.open returned null - popup blocked?");
          // 显示一个包含搜索URL的提示，让用户可以手动复制
          showSearchUrlToast(source.name, searchUrl);
        }
      } else if (source.type === "api") {
        // API搜索，处理返回结果
        const apiUrl = source.url.replace(
          "{query}",
          encodeURIComponent(videoID),
        );
        const data = await fetchSubtitleAPI(apiUrl);

        if (data?.code === 0 && data.data?.length > 0) {
          const relevantSubs = data.data.filter(
            (item) => item.url && item.url.toLowerCase().includes(".srt"),
          );
          if (relevantSubs.length > 0) {
            showSubtitleList(relevantSubs);
          } else {
            showToast(`(在线搜索) 未找到 ${videoID} 的SRT字幕`);
          }
        } else {
          showToast(
            `(在线搜索) 未找到 ${videoID} 的匹配字幕 ${data?.code ? `(Code: ${data.code})` : ""}`,
          );
        }
      }
    } catch (error) {
      console.error(`Subtitle search error (Source: ${source.name}):`, error);
      showToast(`(在线搜索) 字幕搜索出错: ${error.message}`);
    }
  }

